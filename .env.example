# Optional SSH host; leave empty to deploy to a local folder.
DESTINATION=vimexx  # ssh config
LOCAL_DIR=./dist
REMOTE_DIR=./public_html
# Ownership on the destination (requires permission to chown there).
DEPLOY_OWNER=root:docker

# Site domain or absolute URL, and email local part.
SITE_URL=stefkorporaal.is
SITE_EMAIL_NAME=admin
