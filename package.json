{
    "name": "skorporaal.astro",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "astro": "astro",
        "build:astro": "astro build",
        "check:eslint": "eslint",
        "check:prettier": "prettier -c ./src",
        "fix:eslint": "eslint --fix",
        "fix:prettier": "prettier -w ./src",
        "lint:check": "run-s check:*",
        "lint:fix": "run-s fix:*",
        "build": "run-s clean build:*",
        "clean": "del-cli dist",
        "check": "run-p --continue-on-error check:*",
        "fix": "run-s --continue-on-error fix:*",
        "dev": "astro dev --host",
        "preview": "astro preview",
        "test": "vitest"
    },
    "devDependencies": {
        "@astrojs/markdown-satteri": "0.4.3",
        "@astrojs/mdx": "8.0.3",
        "@astrojs/react": "7.0.1",
        "@eslint/compat": "2.1.1",
        "@eslint/eslintrc": "3.3.7",
        "@eslint/js": "10.0.1",
        "@fontsource/nunito": "5.3.0",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.3",
        "@types/lodash-es": "4.17.12",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "astro": "7.3.8",
        "clsx": "2.1.1",
        "del-cli": "8.0.1",
        "devicon": "2.17.0",
        "eslint": "10.12.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "katex": "0.19.0",
        "lodash-es": "4.18.1",
        "npm-run-all2": "9.0.3",
        "oxc-transform-react": "0.145.0",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "1.1.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "satteri-external-links": "0.1.1",
        "satteri-katex": "0.1.1",
        "slugify": "1.6.9",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.1",
        "usehooks-ts": "3.1.1",
        "vite": "8.3.4",
        "vitest": "5.0.3"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    },
    "//": {
        "satteri-katex override": "satteri-katex declares KaTeX ^0.16.25. Use the project's KaTeX version for rendering as well as CSS so their versions stay aligned; verified with KaTeX 0.19.0.",
        "@astrojs/react override": "@astrojs/react 7.0.1 requires oxc-transform-react ^0.145.0, but @vitejs/plugin-react 6.1.2 requires ^0.152.0. These pre-1.0 ranges do not overlap. Pin plugin-react to 6.1.1, which accepts ^0.145.0, until Astro updates its compiler requirement to a compatible range."
    },
    "overrides": {
        "satteri-katex": {
            "katex": "$katex"
        },
        "@astrojs/react": {
            "@vitejs/plugin-react": "6.1.1"
        }
    }
}
