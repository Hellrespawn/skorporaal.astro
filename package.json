{
    "name": "skorporaal.astro",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "astro": "astro",
        "deploy": "./deploy.sh",
        "build:astro": "astro build",
        "check:eslint": "eslint",
        "check:prettier": "prettier -c ./src",
        "fix:eslint": "eslint --fix",
        "fix:prettier": "prettier -w ./src",
        "lint:check": "run-s check:*",
        "lint:fix": "run-s fix:*",
        "build": "run-s clean build:*",
        "clean": "del-cli dist",
        "check": "run-p --continue-on-error check:*",
        "format": "run-s --continue-on-error format:*",
        "dev": "astro dev --host",
        "preview": "astro preview",
        "test": "vitest"
    },
    "devDependencies": {
        "@astrojs/markdown-remark": "7.2.1",
        "@astrojs/mdx": "7.0.4",
        "@astrojs/react": "6.0.1",
        "@eslint/compat": "2.1.0",
        "@eslint/eslintrc": "3.3.6",
        "@eslint/js": "10.0.1",
        "@fontsource/nunito": "5.3.0",
        "@tailwindcss/typography": "0.5.20",
        "@tailwindcss/vite": "4.3.3",
        "@types/lodash-es": "4.17.12",
        "@types/node": "26.1.1",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "astro": "7.1.4",
        "babel-plugin-react-compiler": "1.0.0",
        "clsx": "2.1.1",
        "del-cli": "7.0.0",
        "devicon": "2.17.0",
        "eslint": "10.8.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.8.0",
        "katex": "0.18.1",
        "lodash-es": "4.18.1",
        "npm-run-all2": "9.0.2",
        "prettier": "3.9.6",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "rehype-external-links": "3.0.0",
        "rehype-katex": "7.0.1",
        "remark-math": "6.0.0",
        "slugify": "1.6.9",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.65.0",
        "usehooks-ts": "3.1.1",
        "vite": "8.1.5",
        "vitest": "4.1.10"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
